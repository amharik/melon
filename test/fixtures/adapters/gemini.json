{
  "adapter": "gemini",
  "hostname": "gemini.google.com",
  "elements": [
    {
      "key": "search",
      "tag": "DIV",
      "contentEditable": true,
      "attrs": { "role": "searchbox", "aria-label": "Search", "contenteditable": "true" },
      "visible": true,
      "order": 1
    },
    {
      "key": "composer",
      "tag": "DIV",
      "contentEditable": true,
      "attrs": {
        "class": "ql-editor",
        "contenteditable": "true",
        "aria-label": "Enter a prompt here"
      },
      "visible": true,
      "order": 2
    },
    {
      "key": "hidden-send",
      "tag": "BUTTON",
      "attrs": { "aria-label": "Send message" },
      "visible": false,
      "order": 3
    },
    {
      "key": "send",
      "tag": "BUTTON",
      "attrs": { "aria-label": "Send message" },
      "visible": true,
      "order": 4
    },
    {
      "key": "stopping",
      "tag": "BUTTON",
      "attrs": { "aria-label": "Stop response", "aria-disabled": "true" },
      "visible": true,
      "order": 5
    },
    {
      "key": "stop",
      "tag": "BUTTON",
      "attrs": { "aria-label": "Stop response" },
      "visible": true,
      "order": 6
    },
    {
      "key": "response",
      "tag": "MODEL-RESPONSE",
      "text": "Gemini answer",
      "visible": true,
      "order": 7
    },
    {
      "key": "response-content",
      "tag": "MESSAGE-CONTENT",
      "text": "Gemini answer",
      "visible": true,
      "order": 8,
      "parent": "response"
    },
    {
      "key": "response-text",
      "tag": "DIV",
      "attrs": { "class": "model-response-text" },
      "text": "Gemini answer",
      "visible": true,
      "order": 9,
      "parent": "response-content"
    }
  ],
  "selectors": {
    "rich-textarea div[contenteditable=\"true\"]": ["composer"],
    "div[contenteditable=\"true\"]": ["search", "composer"],
    "textarea": [],
    "button[aria-label*=\"Send\"]": ["hidden-send", "send"],
    "button.send-button": [],
    "button[type=\"submit\"]": [],
    "button[aria-label*=\"Stop\"]": ["stopping", "stop"],
    "button[aria-label*=\"stop\"]": ["stopping", "stop"],
    "model-response": ["response"],
    "message-content": ["response-content"],
    ".model-response-text": ["response-text"]
  }
}
