{
  "name": "melon",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based dataflow runtime for agentic office tabs",
  "type": "module",
  "bin": {
    "melon": "./bin/melon.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/hub.mjs",
    "mcp": "node server/mcp-server.mjs",
    "test": "node --experimental-websocket --test --test-concurrency=1 \"test/**/*.test.mjs\"",
    "eval": "node scripts/eval.mjs",
    "e2e": "node scripts/e2e-extension.mjs",
    "e2e:ai": "node scripts/e2e-ai.mjs",
    "e2e:live": "node scripts/e2e-live.mjs",
    "e2e:gpu": "node scripts/gpu-probe.mjs",
    "test:remote": "scripts/e2e-remote.sh",
    "build": "scripts/build.sh",
    "build:extension": "mkdir -p dist && (cd extension && zip -qr ../dist/melon-extension.zip .)",
    "vendor:ai": "scripts/vendor-ai.sh",
    "vendor:markup": "node scripts/vendor-markup.mjs",
    "eval:promptfoo": "npx --yes promptfoo@0.125.1 eval -c evals/promptfooconfig.yaml",
    "test:coverage": "node --experimental-websocket --experimental-test-coverage --test --test-concurrency=1 \"test/**/*.test.mjs\"",
    "lint": "node scripts/check-syntax.mjs && tsc -p jsconfig.json && biome lint . --max-diagnostics=20 --reporter=summary",
    "lint:biome": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc -p jsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@types/node": "26.6.6",
    "fast-check": "4.5.3",
    "jsdom": "26.1.0",
    "playwright": "^1.65.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.7.0",
    "dompurify": "3.4.18",
    "marked": "18.2.0"
  }
}
