{
  "$schema": "https://biomejs.dev/schemas/2.3.14/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!web/vendor",
      "!extension/vendor",
      "!web/wasm",
      "!core-runtime/target",
      "!dist",
      "!.melon",
      "!**/*.min.js",
      "!adapters/adapter-pack.json",
      "!test/fixtures/adapters",
      "!extension/adapter-pack-key.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noAssignInExpressions": "off",
        "noControlCharactersInRegex": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
